# Outside Git: /etc/guteli/compose.env, mode 0600. Never source this file.
GUTELI_APP_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOCAL_IMAGE_ID
GUTELI_POSTGRES_IMAGE=postgres:17-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
GUTELI_CADDY_IMAGE=caddy:2@sha256:REPLACE_WITH_VERIFIED_DIGEST
GUTELI_NODE_IMAGE=node:22-bookworm-slim@sha256:REPLACE_WITH_VERIFIED_DIGEST
GUTELI_RUNTIME_ENV=/etc/guteli/runtime.env
GUTELI_POSTGRES_PASSWORD_FILE=/etc/guteli/postgres-password
GUTELI_BACKUP_KEY_FILE=/etc/guteli/backup-key
GUTELI_DATA_ROOT=/srv/guteli-data
GUTELI_BACKUP_ROOT=/srv/guteli-backups
GUTELI_DATA_UUID=REPLACE_WITH_LSBLK_UUID
GUTELI_BACKUP_UUID=REPLACE_WITH_LSBLK_UUID
GUTELI_HOSTNAME=REPLACE_WITH_APPROVED_HOSTNAME
ACME_EMAIL=REPLACE_WITH_APPROVED_EMAIL
