# Public portfolio safety: anything except the exact value "false" stays in demo mode.
NEXT_PUBLIC_DEMO_MODE=true

# Live handoff is opt-in and only accepts the confirmed number with country code.
# NEXT_PUBLIC_WHATSAPP_DESTINATION=50242569861

DATABASE_URL=postgresql://guteli:guteli@localhost:5432/guteli
DATABASE_URL_TEST=postgresql://guteli:guteli@127.0.0.1:55433/guteli_test
# Required only by the public order endpoint. Supply distinct secrets with at
# least 32 UTF-8 bytes; placeholders must never be used in production.
# RATE_LIMIT_SECRET=replace-with-a-32-byte-or-longer-secret
# RECEIPT_TOKEN_SECRET=replace-with-a-32-byte-or-longer-secret
# Set only behind a proxy that overwrites and sanitizes X-Forwarded-For.
# TRUSTED_PROXY_HOPS=0
# Required for local development and test runs; Docker production uses /app/uploads.
UPLOADS_ROOT=uploads_data

# Integrations are fail-closed. These exact false defaults do not activate
# provider or payment behavior.
WHATSAPP_NOTIFICATIONS_ENABLED=false
PAYMENTS_ENABLED=false

# Owner WhatsApp Cloud API — REQUIRES EXTERNAL CONFIGURATION.
# Account readiness, owner-recipient consent, exact template approval/mapping,
# and a currently supported Graph API version have not been confirmed.
WHATSAPP_ACCOUNT_READY=false
WHATSAPP_OWNER_CONSENT_CONFIRMED=false
# Must equal guteli-owner-order-created-v1 only after that exact one-body-text-
# parameter contract has been externally approved and its limits validated.
# WHATSAPP_TEMPLATE_CONTRACT_ACK=guteli-owner-order-created-v1
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_API_VERSION=vXX.X
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# OWNER_WHATSAPP_DESTINATION=502XXXXXXXX
# WHATSAPP_APPROVED_TEMPLATE_NAME=
# WHATSAPP_APPROVED_TEMPLATE_LANGUAGE=es_GT
# Set only after externally verifying the character ceiling for the exact
# approved template, language, parameter mapping, and current API version.
# No application default is safe evidence of Meta template support.
# WHATSAPP_TEMPLATE_BODY_MAX_CHARACTERS=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# PUBLIC_ADMIN_BASE_URL=https://admin.example.com
